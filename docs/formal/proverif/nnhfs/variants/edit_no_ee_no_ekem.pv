(* ---- generated by docs/formal/proverif/nnhfs/run.py; do not edit ----
   Variant:  edit_no_ee_no_ekem
   Scenario: passive
   Edits:    no_ee, no_ekem
   Breaks:   none
   PWD-T1 Noise_NNhfs. The walk follows the pattern; an edit drops a token.
   Load with: proverif -lib docs/formal/proverif/lib/noise.pvl <this file> *)

free c: channel.
(* The honest pair's link under a passive attacker. Every message that
   crosses it is also written to c, so the attacker reads all and injects
   nothing. The active scenario uses c for the link too. *)
free hs: channel [private].

const protocol_name: bitstring.
(* Network ids are public: the first 16 bytes of
   cSHAKE256(S = NETWORK_ID_DST, X = genesis block hash)
   (prefix.rs, network_id_from_genesis). Two of them, so a handshake
   across networks can be asked about. *)
free nidA: bitstring.
free nidB: bitstring.

(* The first transport bodies. Secret unless the handshake leaks them.
   body_len is the public 2-byte length header (channel.rs). *)
free req0: bitstring [private].
free rep0: bitstring [private].
free req1: bitstring [private].
free rep1: bitstring [private].
const body_len: bitstring.
const len_ad: bitstring.
const body_ad: bitstring.

(* (network id, k_i2r, k_r2i): the Split keys a role ends with. *)
event InitiatorDone(bitstring, key, key).
event ResponderDone(bitstring, key, key).

let Initiator(nid: bitstring, link: channel, req: bitstring, leak: bool) =
  let ck0 = hinit(protocol_name) in
  let h0 = mixh(hinit(protocol_name), nid) in
  (* e, ek *)
  new ei: scalar;
  let epub = exp(g, ei) in
  let h1 = mixh(h0, p2b(epub)) in
  new eki: kemsk;
  let ekpub = kpk(eki) in
  let h2 = mixh(h1, kpk2b(ekpub)) in
  let h3 = mixh(h2, empty) in
  out(link, (epub, ekpub));
  out(c, (epub, ekpub));
  (* e *)
  in(link, (re: point, tag: bitstring));
  let h4 = mixh(h3, p2b(re)) in
  let (=empty) = tag in
  let h5 = mixh(h4, tag) in
  let k_i2r = split1(ck0) in
  let k_r2i = split2(ck0) in
  event InitiatorDone(nid, k_i2r, k_r2i);
  (* length under len_ad at n0, body under body_ad at n1 *)
  let req_len = aead(k_i2r, n0, len_ad, body_len) in
  let req_body = aead(k_i2r, n1, body_ad, req) in
  out(link, (req_len, req_body));
  out(c, (req_len, req_body));
  in(link, (rep_len: bitstring, rep_body: bitstring));
  let (=body_len) = adec(k_r2i, n0, len_ad, rep_len) in
  let reply = adec(k_r2i, n1, body_ad, rep_body) in
  (if leak then phase 1; out(c, (ei, eki))).

let Responder(nid: bitstring, link: channel, rep: bitstring, leak: bool) =
  let ck0 = hinit(protocol_name) in
  let h0 = mixh(hinit(protocol_name), nid) in
  (* e, ek *)
  in(link, (ie: point, iek: kempk));
  let h1 = mixh(h0, p2b(ie)) in
  let h2 = mixh(h1, kpk2b(iek)) in
  let h3 = mixh(h2, empty) in
  (* e *)
  new er: scalar;
  let repub = exp(g, er) in
  let h4 = mixh(h3, p2b(repub)) in
  let tag = empty in
  let h5 = mixh(h4, tag) in
  out(link, (repub, tag));
  out(c, (repub, tag));
  let k_i2r = split1(ck0) in
  let k_r2i = split2(ck0) in
  event ResponderDone(nid, k_i2r, k_r2i);
  (* length under len_ad at n0, body under body_ad at n1 *)
  in(link, (req_len: bitstring, req_body: bitstring));
  let (=body_len) = adec(k_i2r, n0, len_ad, req_len) in
  let request = adec(k_i2r, n1, body_ad, req_body) in
  let rep_len = aead(k_r2i, n0, len_ad, body_len) in
  let rep_body = aead(k_r2i, n1, body_ad, rep) in
  out(link, (rep_len, rep_body));
  out(c, (rep_len, rep_body));
  (if leak then phase 1; out(c, er)).

query attacker(req0).
query attacker(rep0).
query n: bitstring, k1: key, k2: key;
  event(InitiatorDone(n, k1, k2)) && attacker(k1).
query n: bitstring, k1: key, k2: key;
  event(InitiatorDone(n, k1, k2)) && attacker(k2).
query k1: key, k2: key;
  event(InitiatorDone(nidA, k1, k2)) && event(ResponderDone(nidA, k1, k2)).

process
  ( !Initiator(nidA, hs, req0, false) | !Responder(nidA, hs, rep0, false) )
