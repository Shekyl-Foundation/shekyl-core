{
  "version": 3,
  "description": "PQC multisig test vectors for scheme_id=2 (Ed25519 + ML-DSA-65 hybrid M-of-N). Regenerated for MSW-1: MAX=5, 3-byte container header (version || n_total || m_required), and per-participant spend-auth pubkeys. The F-1 fossil model (2-byte header, `2 + n*1996`, MAX=7) is retired. Authoritative source: shekyl-crypto-pq::multisig.",
  "constants": {
    "scheme_id": 2,
    "max_participants": 5,
    "single_key_canonical_len": 1996,
    "single_sig_canonical_len": 3385,
    "spend_auth_pubkey_len": 32,
    "container_version": 1
  },
  "key_container_wire_format": {
    "description": "version(1) || n_total(1) || m_required(1) || key[0](1996) || ... || key[N-1](1996) || spend_auth_pk[0](32) || ... || spend_auth_pk[N-1](32)",
    "header_bytes": 3,
    "key_size": 1996,
    "spend_auth_pubkey_size": 32,
    "per_participant_bytes": 2028,
    "expected_blob_len_formula": "3 + n * 2028",
    "examples": [
      {"config": "1-of-1", "n": 1, "m": 1, "expected_blob_len": 2031},
      {"config": "2-of-3", "n": 3, "m": 2, "expected_blob_len": 6087},
      {"config": "3-of-5", "n": 5, "m": 3, "expected_blob_len": 10143},
      {"config": "5-of-5", "n": 5, "m": 5, "expected_blob_len": 10143}
    ]
  },
  "sig_container_wire_format": {
    "description": "sig_count(1) || sig[0](3385) || ... || sig[M-1](3385) || idx[0](1) || ... || idx[M-1](1)",
    "header_bytes": 1,
    "sig_size": 3385,
    "expected_blob_len_formula": "1 + m * 3385 + m",
    "examples": [
      {"config": "1-of-1", "m": 1, "expected_blob_len": 3387},
      {"config": "2-of-3", "m": 2, "expected_blob_len": 6773},
      {"config": "3-of-5", "m": 3, "expected_blob_len": 10159},
      {"config": "5-of-5", "m": 5, "expected_blob_len": 16931}
    ]
  },
  "verification_pipeline": {
    "description": "9-check adversarial validation",
    "checks": [
      {"number": 1, "name": "scheme_match", "error": "SchemeMismatch", "description": "scheme_id must equal 2"},
      {"number": 2, "name": "parameter_bounds", "error": "ParameterBounds", "description": "container version == 1 and 0 < m <= n <= 5"},
      {"number": 3, "name": "key_blob_length", "error": "KeyBlobLength", "description": "blob len must equal 3 + n * 2028 (version + n_total + m_required, then n hybrid keys of 1996 B and n spend-auth pubkeys of 32 B)"},
      {"number": 4, "name": "sig_blob_length", "error": "SigBlobLength", "description": "blob len must equal 1 + m * 3385 + m"},
      {"number": 5, "name": "threshold_match", "error": "ThresholdMismatch", "description": "sig_count must equal m_required"},
      {"number": 6, "name": "index_validity", "error": "IndexOutOfRange", "description": "all signer indices < n_total"},
      {"number": 7, "name": "index_ordering", "error": "IndicesNotAscending", "description": "signer indices strictly ascending"},
      {"number": 8, "name": "key_uniqueness", "error": "DuplicateKeys", "description": "no two keys share canonical encoding"},
      {"number": 9, "name": "crypto_verify", "error": "CryptoVerifyFailed", "description": "each sig[i] must verify under key[idx[i]] for the transaction message"}
    ]
  },
  "size_regression": {
    "description": "Expected on-chain pqc_auth sizes for common configurations (key_blob + sig_blob)",
    "configurations": [
      {"config": "1-of-1", "key_blob_bytes": 2031, "sig_blob_bytes": 3387, "total_pqc_auth_bytes": 5418},
      {"config": "2-of-3", "key_blob_bytes": 6087, "sig_blob_bytes": 6773, "total_pqc_auth_bytes": 12860},
      {"config": "3-of-5", "key_blob_bytes": 10143, "sig_blob_bytes": 10159, "total_pqc_auth_bytes": 20302},
      {"config": "5-of-5", "key_blob_bytes": 10143, "sig_blob_bytes": 16931, "total_pqc_auth_bytes": 27074}
    ]
  },
  "adversarial_test_cases": [
    {"name": "empty_key_blob", "input": "", "expected_error": "KeyBlobLength"},
    {"name": "single_byte_key_blob", "input_hex": "01", "expected_error": "KeyBlobLength"},
    {"name": "wrong_version", "input_hex": "000302", "expected_error": "ParameterBounds"},
    {"name": "n_zero", "input_hex": "010002", "expected_error": "ParameterBounds"},
    {"name": "m_zero", "input_hex": "010200", "expected_error": "ParameterBounds"},
    {"name": "m_greater_than_n", "input_hex": "010203", "expected_error": "ParameterBounds"},
    {"name": "n_exceeds_max", "input_hex": "010602", "expected_error": "ParameterBounds"},
    {"name": "empty_sig_blob", "input": "", "expected_error": "SigBlobLength"},
    {"name": "sig_count_zero", "input_hex": "00", "expected_error": "ParameterBounds"},
    {"name": "sig_count_exceeds_max", "input_hex": "06", "expected_error": "ParameterBounds"}
  ]
}
