# PROVIDE: shekyld
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# The Shekyl daemon as the machine's service instance on FreeBSD
# (`--service`; RPC_CHANNEL.md §7.1, INPUT_GRAMMAR.md IG-Q105).
#
# The release archive holds the binary at `shekyld` and this script at
# `rc.d/shekyld`. Install both, as root:
#
#   install -m 0555 shekyld /usr/local/bin/shekyld
#   pw useradd shekyl -d /nonexistent -s /usr/sbin/nologin -c "Shekyl daemon"
#   install -m 0555 rc.d/shekyld /usr/local/etc/rc.d/shekyld
#   sysrc shekyld_enable=YES
#   service shekyld start
#
# Settings in /etc/rc.conf (sysrc):
#
#   shekyld_enable (bool)  Start at boot. Default NO.
#   shekyld_args (str)     More options for shekyld, e.g. "--network testnet".
#                          Default empty (mainnet).
#
# The daemon runs as the `shekyl` account. daemon(8) supervises the
# `supervise` branch below and sends what the daemon prints to syslog as
# `shekyld`, so a refused start is in /var/log/messages. Its own log is
# /var/log/shekyl/shekyld.log. Its configuration file is
# /etc/shekyl/shekyld-<network>.toml when one exists.
#
# FreeBSD 14's daemon(8) restarts on every child termination when -R is
# set, including a clean exit. The Linux unit is Restart=on-failure, so
# the restart lives in `shekyld_supervise` instead: a failure is retried
# after restart_seconds (the unit's RestartSec), and a clean exit ends the
# supervisor. Clean is what the unit counts as clean: exit 0, exit 130 (a
# second stop: the operator forced it; SuccessExitStatus=130), or death by
# SIGHUP, SIGINT, SIGTERM or SIGPIPE. The shell reports exit 130 and death
# by SIGINT alike. An RPC stop and a SIGTERM the
# daemon has taken leave 0; a SIGTERM that arrives while the node is still
# opening, before the daemon owns its stop triggers, ends it by the signal.
# A refused start exits non-zero, so it is retried, and the refusal is in
# syslog.
#
# The daemon creates none of the directories below; it checks them and
# refuses to start naming the one that is wrong. This script creates them
# before every start, because /var/run is emptied at boot:
#
#   /var/run/shekyl  the service's rendezvous directory: the account's,
#                    readable by every user, writable by no one else
#   /var/db/shekyl   the service's data home: the account's alone (0700)
#   /var/log/shekyl  the daemon's log directory

# The supervised command (`service` runs this file with `start`; daemon(8)
# runs it with `supervise`). Defined before `/etc/rc.subr` so the
# supervise branch does not load the rc functions.
shekyld_supervise()
{
	# The packaged unit's RestartSec. The launch-recipe gate holds the
	# two equal.
	restart_seconds=30
	child=0
	on_stop() {
		if [ "$child" -ne 0 ]; then
			kill -TERM "$child" 2>/dev/null
			wait "$child" 2>/dev/null
		fi
		exit 0
	}
	trap on_stop TERM
	while :; do
		/usr/local/bin/shekyld "$@" &
		child=$!
		wait "$child"
		status=$?
		child=0
		# The shell reports a death by signal N as 128+N.
		case "$status" in
		0 | 129 | 130 | 141 | 143) exit 0 ;;
		esac
		sleep "$restart_seconds" &
		child=$!
		wait "$child"
		child=0
	done
}

if [ "${1:-}" = "supervise" ]; then
	shift
	shekyld_supervise "$@"
fi

. /etc/rc.subr

name=shekyld
rcvar=shekyld_enable
desc="Shekyl daemon"

load_rc_config $name

: ${shekyld_enable:=NO}
: ${shekyld_args:=}

pidfile="/var/run/${name}.pid"
procname=/usr/sbin/daemon
command=/usr/sbin/daemon
# No -r and no -R. Those flags restart a clean exit; shekyld_supervise
# is where a failure is retried. -P is the supervisor's pid, so
# `service stop` signals daemon(8), which signals this script.
command_args="-f -S -T ${name} -P ${pidfile} -u shekyl /bin/sh /usr/local/etc/rc.d/${name} supervise --service --log-file /var/log/shekyl/shekyld.log ${shekyld_args}"
start_precmd="${name}_prestart"

shekyld_prestart()
{
	if ! pw usershow shekyl >/dev/null 2>&1; then
		err 1 "the account shekyl does not exist; create it with: pw useradd shekyl -d /nonexistent -s /usr/sbin/nologin -c \"Shekyl daemon\""
	fi
	install -d -o shekyl -g shekyl -m 0755 /var/run/shekyl || return 1
	install -d -o shekyl -g shekyl -m 0700 /var/db/shekyl || return 1
	install -d -o shekyl -g shekyl -m 0750 /var/log/shekyl || return 1
}

run_rc_command "$1"
