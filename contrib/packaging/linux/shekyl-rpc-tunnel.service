[Unit]
Description=Shekyl RPC tunnel
After=network-online.target
Wants=network-online.target

# The tunnel (RPC_CHANNEL.md §8) on a consumer's host: it serves a node's
# RPC to this host's consumers in plaintext on loopback, and reaches the
# node over the channel as its own key (Rick, 2026-11-16).
#
# Installed, not enabled: it needs a configuration and a key first. The
# package declares its account, shekyl-tunnel (shekyl.sysusers: no home, no
# login, never the daemon's account or in its group), and makes its
# configuration directory /etc/shekyl-tunnel, root:shekyl-tunnel 0750
# (shekyl.tmpfiles). The configuration and the node's bundle live there as
# root:shekyl-tunnel 0640: the tunnel reads them and cannot write them.
#
#   write the node's bundle (the node's `rpc bundle show`) and the
#     configuration: daemon-endpoint, daemon-bundle-file =
#     "/etc/shekyl-tunnel/node.bundle", and listen, a loopback address and
#     port; rpc-grant if the default `view` is not what the consumers need
#   install -m 0640 -o root -g shekyl-tunnel node.bundle /etc/shekyl-tunnel/node.bundle
#   install -m 0640 -o root -g shekyl-tunnel shekyl-rpc-tunnel.toml \
#       /etc/shekyl-tunnel/shekyl-rpc-tunnel.toml
#   install -d -o shekyl-tunnel -g shekyl-tunnel -m 0700 /var/lib/shekyl-tunnel
#   runuser -u shekyl-tunnel -- shekyl-rpc-tunnel --rpc-key-create \
#       --config-file /etc/shekyl-tunnel/shekyl-rpc-tunnel.toml \
#       --rpc-key-file /var/lib/shekyl-tunnel/rpc-shekyl-rpc-tunnel.key
#     (prints the fingerprint; enroll it on the node with
#      `shekyl-cli rpc client add FINGERPRINT --ceiling GRANTS`)
#   systemctl enable --now shekyl-rpc-tunnel
#
# Another network: a drop-in whose ExecStart adds `--network testnet`.
# The launch-recipe gate holds this file to the tunnel's table.

[Service]
Type=simple
ExecStart=/usr/local/bin/shekyl-rpc-tunnel --config-file /etc/shekyl-tunnel/shekyl-rpc-tunnel.toml --rpc-key-file /var/lib/shekyl-tunnel/rpc-shekyl-rpc-tunnel.key --log-file /var/log/shekyl-tunnel/shekyl-rpc-tunnel.log

# Its own account: never the daemon's `shekyl`, never root.
User=shekyl-tunnel
Group=shekyl-tunnel

# /var/lib/shekyl-tunnel: the tunnel's key, its account's alone.
StateDirectory=shekyl-tunnel
StateDirectoryMode=0700
LogsDirectory=shekyl-tunnel

Restart=on-failure
RestartSec=30
# Exit 130 is a second stop: an operator forced the stop, so it is not
# restarted (Rick, 2026-11-21). The FreeBSD script counts it clean too.
SuccessExitStatus=130

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/shekyl-tunnel /var/log/shekyl-tunnel

# The hardening set (Rick, 2026-11-16); the launch-recipe gate holds the
# unit to it. The tunnel needs no capability, opens IP and local sockets
# only, and runs no JIT, so W^X stays on (shekyld's unit cannot set
# MemoryDenyWriteExecute: RandomX's JIT writes code).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
