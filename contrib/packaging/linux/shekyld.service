[Unit]
Description=Shekyl Daemon
After=network-online.target
Wants=network-online.target

[Service]
# The daemon's own slice, weighed 4:1 against user.slice under contention
# (shekyl.slice, shipped beside this unit; ruled 2026-10-12).
Slice=shekyl.slice
Type=simple
# No console unless asked (--console), so nothing reads stdin under the
# service manager. The two paths are the unit's StateDirectory and
# LogsDirectory below; the recipe gate holds them equal.
ExecStart=/usr/local/bin/shekyld --data-dir /var/lib/shekyl --log-file /var/log/shekyl/shekyld.log
ExecStartPre=/bin/mkdir -p /var/log/shekyl

User=shekyl
Group=shekyl

RuntimeDirectory=shekyl
StateDirectory=shekyl
LogsDirectory=shekyl

Restart=on-failure
RestartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shekyl /var/log/shekyl

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
