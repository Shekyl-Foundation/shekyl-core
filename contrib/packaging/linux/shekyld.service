[Unit]
Description=Shekyl Daemon
After=network-online.target
Wants=network-online.target

[Service]
# The daemon's own slice, weighed 4:1 against user.slice under contention
# (shekyl.slice, shipped beside this unit; ruled 2026-10-12).
Slice=shekyl.slice
Type=simple
# No console unless asked (--console), so nothing reads stdin under the
# service manager. The two paths are the unit's StateDirectory and
# LogsDirectory below; the recipe gate holds them equal. `--service`: this
# is the machine's service instance, which serves no owner's socket and is
# given no socket directory (INPUT_GRAMMAR.md IG-Q105).
ExecStart=/usr/local/bin/shekyld --service --data-dir /var/lib/shekyl --log-file /var/log/shekyl/shekyld.log
ExecStartPre=/bin/mkdir -p /var/log/shekyl

User=shekyl
Group=shekyl

# /run/shekyl: the service's rendezvous directory (RPC_CHANNEL.md §7.1),
# the daemon's account's and readable by every user, which the daemon
# checks and never creates.
RuntimeDirectory=shekyl
RuntimeDirectoryMode=0755
StateDirectory=shekyl
LogsDirectory=shekyl

Restart=on-failure
RestartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shekyl /var/log/shekyl

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
